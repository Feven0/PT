# Frontend environment config. Copy to `.env` and adjust if needed.
#
# Points at 10 Academy's hosted DEV services so the app works without running
# the backend or any LLM keys locally.

# Strapi CMS (GraphQL + login)
VITE_API_BACKEND_URL='https://dev-cms.10academy.org'

# iPersona FastAPI backend ("frog"). For a local backend use: 'http://localhost:4500'
VITE_API_LEAP_JOB_BACKEND_URL='https://dev-frog.10academy.org'

VITE_API_BACKEND_STAGE='dev'
