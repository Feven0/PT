datasource db {
  provider          = "postgresql"
  url               = "postgresql://postgres:123@localhost:5432/parrot"
}

generator db {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

model IPersona_Session {
    id                Int                @id @default(autoincrement())
    slug              String?
    attributes        Json?
    metadata          Json?
    status            String?
    tinder_job_profile_id  Int?
    tinder_user_profile_id Int?
    i_persona_observers   IPersona_Observer[]
    i_persona_messages    IPersona_Message[]
    createdAt         DateTime           @default(now())
    updatedAt         DateTime           @updatedAt
}

model IPersona_Message {
    id                Int                @id @default(autoincrement())
    attributes        Json?
    metadata          Json?
    i_persona_session_id Int?
    i_persona_session IPersona_Session?  @relation(fields: [i_persona_session_id], references: [id])
    createdAt         DateTime           @default(now())
    updatedAt         DateTime           @updatedAt
}

model IPersona_Observer {
    id                Int                @id @default(autoincrement())
    attributes        Json?
    metadata          Json?
    status            String?
    i_persona_session_id Int?
    i_persona_session IPersona_Session?  @relation(fields: [i_persona_session_id], references: [id])
    i_persona_session_overall_observer_id Int?
    i_persona_session_overall_observer IPersona_Session_Overall_Observer? @relation(fields: [i_persona_session_overall_observer_id], references: [id])
    createdAt         DateTime           @default(now())
    updatedAt         DateTime           @updatedAt
}

model IPersona_Session_Overall_Observer {
    id                Int                @id @default(autoincrement())
    attributes        Json?
    metadata          Json?
    tinder_user_profile_id Int?
    tinder_job_profile_id  Int?
    i_persona_observers   IPersona_Observer[]
    createdAt         DateTime           @default(now())
    updatedAt         DateTime           @updatedAt
}