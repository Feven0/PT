# Test Environment Configuration Example
# Copy this file to .env.test and modify as needed

# App Settings
APP_NAME=ipersona-test
ENVIRONMENT=test
LOG_LEVEL=DEBUG
METRICS_ENABLED=true

# Infrastructure Settings
S3_BUCKET=test-bucket
S3_REGION=us-east-1
WEAVIATE_URL=http://localhost:8080
REDIS_URL=redis://localhost:6379
STRAPI_BASE_URL=http://localhost:1337

# Service Settings
WEBRTC_ICE_SERVERS=["stun:stun.l.google.com:19302"]
WEBSOCKET_PING_INTERVAL=30
ANALYSIS_BATCH_SIZE=10

# Security Settings
JWT_SECRET=test-secret-key-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# Test Settings
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=test-password
MOCK_EXTERNAL_SERVICES=true

# Database Settings
TEST_DB_URL=sqlite:///:memory:
TEST_DB_ECHO=false

# Mock Service URLs
MOCK_S3_URL=http://localhost:4566
MOCK_WEAVIATE_URL=http://localhost:8080
MOCK_REDIS_URL=redis://localhost:6379

# Test Timeouts
TEST_TIMEOUT=30
ASYNC_TEST_TIMEOUT=60 